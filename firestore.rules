rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // v71: enlaces privados de solo lectura. Lectura solo con el id exacto (get), nunca listar.
    // Escritura solo por el dueño (campo owner == su uid) y solo si es un usuario de la app.
    match /shares/{token} {
      allow get: if token.size() >= 20;
      allow list: if false;
      allow create: if request.auth != null && token.size() >= 20
        && request.resource.data.owner == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/data/state);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      // v72: buzón de compras enviadas desde el enlace. Cualquiera con el token puede CREAR (no leer, no listar, no editar).
      // Solo Joe (dueño del enlace) puede leer y borrar.
      match /inbox/{id} {
        // v140 (LOCAL, sin desplegar): hoja de cuentas de Tony.
        // Solo CREAR en el buzón del enlace de Tony (mismo modelo que purchase/settle).
        // No lee ni escribe users/{uid} ni el doc shares/{token} (saldos de Joe). No listar, no editar, no borrar desde el enlace.
        function billsAllocOk(a) {
          return a is map
            && a.keys().hasOnly(['who','mode','pct','amt'])
            && a.keys().hasAll(['who','mode'])
            && a.who is list && a.who.size() > 0 && a.who.size() <= 4
            && a.mode in ['pct','eq','amt','one']
            && (!('pct' in a) || (a.pct is map && a.pct.size() <= 4))
            && (!('amt' in a) || (a.amt is map && a.amt.size() <= 4));
        }
        function billsRowOk(r) {
          return r is map
            && r.keys().hasOnly(['key','total','alloc','fixed'])
            && r.keys().hasAll(['key','total','alloc'])
            && r.key is string && r.key.matches('^(renta|ventanas|agua|luz|gas|telefono|internet|purificador|seguro|letra)$')
            && r.total is number && r.total >= 0 && r.total <= 100000
            && (!('fixed' in r) || r.fixed is bool)
            && billsAllocOk(r.alloc);
        }
        function billsRowsOk(rows) {
          return rows is list && rows.size() > 0 && rows.size() <= 20
            && billsRowOk(rows[0])
            && (rows.size() < 2 || billsRowOk(rows[1]))
            && (rows.size() < 3 || billsRowOk(rows[2]))
            && (rows.size() < 4 || billsRowOk(rows[3]))
            && (rows.size() < 5 || billsRowOk(rows[4]))
            && (rows.size() < 6 || billsRowOk(rows[5]))
            && (rows.size() < 7 || billsRowOk(rows[6]))
            && (rows.size() < 8 || billsRowOk(rows[7]))
            && (rows.size() < 9 || billsRowOk(rows[8]))
            && (rows.size() < 10 || billsRowOk(rows[9]))
            && (rows.size() < 11 || billsRowOk(rows[10]))
            && (rows.size() < 12 || billsRowOk(rows[11]))
            && (rows.size() < 13 || billsRowOk(rows[12]))
            && (rows.size() < 14 || billsRowOk(rows[13]))
            && (rows.size() < 15 || billsRowOk(rows[14]))
            && (rows.size() < 16 || billsRowOk(rows[15]))
            && (rows.size() < 17 || billsRowOk(rows[16]))
            && (rows.size() < 18 || billsRowOk(rows[17]))
            && (rows.size() < 19 || billsRowOk(rows[18]))
            && (rows.size() < 20 || billsRowOk(rows[19]));
        }
        allow create: if exists(/databases/$(database)/documents/shares/$(token))
          && get(/databases/$(database)/documents/shares/$(token)).data.who == 'Tony'
          && request.resource.data.keys().hasOnly(['kind','by','month','rev','rows','at'])
          && request.resource.data.keys().hasAll(['kind','by','month','rev','rows','at'])
          && request.resource.data.kind == 'bills'
          && request.resource.data.by == 'Tony'
          && request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.rev is int && request.resource.data.rev >= 0 && request.resource.data.rev <= 10000
          && billsRowsOk(request.resource.data.rows)
          && request.resource.data.at == request.time;
        // v73: confirmación "Ya pagué" entre Tony y Carlos
        allow create: if exists(/databases/$(database)/documents/shares/$(token))
          && request.resource.data.keys().hasOnly(['kind','by','month','amount','at'])
          && request.resource.data.keys().hasAll(['kind','by','month','amount','at'])
          && request.resource.data.kind == 'settle'
          && request.resource.data.by in ['Tony','Carlos']
          && request.resource.data.by in get(/databases/$(database)/documents/shares/$(token)).data.buyers
          && request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 20000
          && request.resource.data.at == request.time;
        allow create: if exists(/databases/$(database)/documents/shares/$(token))
          && request.resource.data.keys().hasOnly(['by','store','date','total','tax','items','at','scan'])
          && request.resource.data.keys().hasAll(['by','store','date','total','at'])
          && request.resource.data.by is string
          && request.resource.data.by in get(/databases/$(database)/documents/shares/$(token)).data.buyers
          && request.resource.data.store is string && request.resource.data.store.size() > 0 && request.resource.data.store.size() <= 60
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total <= 20000
          && (!('tax' in request.resource.data) || (request.resource.data.tax is number && request.resource.data.tax >= 0 && request.resource.data.tax < request.resource.data.total))
          && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 60))
          && (!('scan' in request.resource.data) || request.resource.data.scan is bool)
          && request.resource.data.at == request.time;
        allow read, delete: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(token)).data.owner == request.auth.uid;
      }
    }
  }
}
