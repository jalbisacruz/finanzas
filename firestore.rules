rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // v71: enlaces privados de solo lectura. Lectura solo con el id exacto (get), nunca listar.
    // Escritura solo por el dueño (campo owner == su uid) y solo si es un usuario de la app.
    match /shares/{token} {
      allow get: if token.size() >= 20;
      allow list: if false;
      allow create: if request.auth != null && token.size() >= 20
        && request.resource.data.owner == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/data/state);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      // v72: buzón de compras enviadas desde el enlace. Cualquiera con el token puede CREAR (no leer, no listar, no editar).
      // Solo Joe (dueño del enlace) puede leer y borrar.
      match /inbox/{id} {
        allow create: if exists(/databases/$(database)/documents/shares/$(token))
          && request.resource.data.keys().hasOnly(['by','store','date','total','tax','items','at','scan'])
          && request.resource.data.keys().hasAll(['by','store','date','total','at'])
          && request.resource.data.by is string
          && request.resource.data.by in get(/databases/$(database)/documents/shares/$(token)).data.buyers
          && request.resource.data.store is string && request.resource.data.store.size() > 0 && request.resource.data.store.size() <= 60
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total <= 20000
          && (!('tax' in request.resource.data) || (request.resource.data.tax is number && request.resource.data.tax >= 0 && request.resource.data.tax < request.resource.data.total))
          && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 60))
          && (!('scan' in request.resource.data) || request.resource.data.scan is bool)
          && request.resource.data.at == request.time;
        allow read, delete: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(token)).data.owner == request.auth.uid;
      }
    }
  }
}
